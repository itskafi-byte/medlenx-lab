rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Membership documents are provisioned only by a trusted administrator,
    // never by the mobile app. The document ID is the Firebase Auth UID.
    function membership(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }
    function isMember(companyId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId &&
        exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)) &&
        membership(companyId).data.active == true;
    }
    // Only the self-owned profile map is writable. Membership and all other
    // administrator-managed fields remain unchanged, including companyId.
    function validProfile(p) {
      return p is map && p.keys().hasOnly([
          'company', 'employeeId', 'fullName', 'designation', 'division',
          'territory', 'portfolio', 'dailyTarget', 'monthlyTarget'
        ]) && p.keys().hasAll([
          'company', 'employeeId', 'fullName', 'designation', 'division',
          'territory', 'portfolio', 'dailyTarget', 'monthlyTarget'
        ])
        && p.company is string && p.company.size() <= 500
        && p.employeeId is string && p.employeeId.size() <= 500
        && p.fullName is string && p.fullName.size() <= 500
        && p.designation is string && p.designation.size() <= 500
        && p.division is string && p.division.size() <= 500
        && p.territory is string && p.territory.size() <= 500
        && p.portfolio is string && p.portfolio.size() <= 500
        && p.dailyTarget is int && p.dailyTarget >= 1 && p.dailyTarget <= 9999
        && p.monthlyTarget is list && p.monthlyTarget.size() <= 100;
    }
    function validAvatar(id) {
      return id is string && id.matches('^avatar_0[1-8]$');
    }
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['officerProfile', 'avatarId'])
        && request.resource.data.keys().hasAny(['officerProfile', 'avatarId'])
        && (!('officerProfile' in request.resource.data) || validProfile(request.resource.data.officerProfile))
        && (!('avatarId' in request.resource.data) || validAvatar(request.resource.data.avatarId));
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['officerProfile', 'avatarId'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['officerProfile']) ||
            ('officerProfile' in request.resource.data && validProfile(request.resource.data.officerProfile)))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['avatarId']) ||
            ('avatarId' in request.resource.data && validAvatar(request.resource.data.avatarId)));
      allow list, delete: if false;
    }
    // Only the tiny avatar ID is visible to active teammates, never user profiles.
    match /companies/{companyId}/avatars/{userId} {
      allow read: if isMember(companyId);
      allow create, update: if isMember(companyId) && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['avatarId'])
        && request.resource.data.keys().hasAll(['avatarId'])
        && validAvatar(request.resource.data.avatarId)
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.avatarId == request.resource.data.avatarId;
      allow delete: if false;
    }
    match /companies/{companyId}/members/{memberId} {
      allow get: if request.auth != null && request.auth.uid == memberId;
      allow list, create, update, delete: if false;
    }
    match /companies/{companyId}/team_scans/{scanId} {
      allow read: if isMember(companyId);
      // New scans are owner-created; attribution and existing metadata remain immutable.
      allow create: if isMember(companyId)
        && request.resource.data.keys().hasOnly([
          'scanId', 'doctorName', 'doctorSpecialty', 'territory', 'medicines',
          'scannedBy', 'createdByUid', 'timestamp', 'captureTimestamp',
          'prescription_date', 'prescription_date_raw'
        ])
        && request.resource.data.keys().hasAll([
          'scanId', 'doctorName', 'doctorSpecialty', 'territory', 'medicines',
          'scannedBy', 'createdByUid', 'timestamp'
        ])
        && scanId.matches("^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$")
        && request.resource.data.scanId == scanId
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.scannedBy == membership(companyId).data.displayName
        && request.resource.data.doctorName is string
        && request.resource.data.doctorName.size() <= 200
        && request.resource.data.doctorSpecialty is string
        && request.resource.data.doctorSpecialty.size() <= 200
        && request.resource.data.territory is string
        && request.resource.data.territory.size() <= 200
        && request.resource.data.medicines is list
        && request.resource.data.medicines.size() <= 100
        && (!('captureTimestamp' in request.resource.data) || request.resource.data.captureTimestamp is timestamp)
        && (!('prescription_date' in request.resource.data) || request.resource.data.prescription_date == null || request.resource.data.prescription_date is timestamp)
        && (!('prescription_date_raw' in request.resource.data) || request.resource.data.prescription_date_raw == null ||
            (request.resource.data.prescription_date_raw is string && request.resource.data.prescription_date_raw.size() <= 1000))
        && request.resource.data.timestamp == request.time;
      // Owner-only, add-once backfill. All other scan fields stay immutable.
      allow update: if isMember(companyId) && resource.data.createdByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prescription_date', 'prescription_date_raw', 'medex_product_ids'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['prescription_date']) ||
            ((!('prescription_date' in resource.data) || resource.data.prescription_date == null) && request.resource.data.prescription_date is timestamp))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['prescription_date_raw']) ||
            ((!('prescription_date_raw' in resource.data) || resource.data.prescription_date_raw == null) && request.resource.data.prescription_date_raw is string && request.resource.data.prescription_date_raw.size() <= 1000))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['medex_product_ids']) ||
            ((!('medex_product_ids' in resource.data) || resource.data.medex_product_ids == null) && request.resource.data.medex_product_ids is string && request.resource.data.medex_product_ids.size() <= 32000));
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
